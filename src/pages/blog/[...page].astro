---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import PostPreview from '../../components/PostPreview.astro';
import Subscribe from '../../components/Subscribe.astro';
import siteConfig from '../../data/site-config';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { getMediumPosts, mediumPostToEntry } from '../../utils/medium-feed';

type NormalizedPost = ReturnType<typeof mediumPostToEntry> | CollectionEntry<'blog'>;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const [localPosts, mediumPosts] = await Promise.all([
        getCollection('blog'),
        getMediumPosts(),
    ]);

    const allPosts: NormalizedPost[] = [
        ...localPosts,
        ...mediumPosts.map(mediumPostToEntry),
    ].sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

    return paginate(allPosts, { pageSize: siteConfig.postsPerPage || 5 });
}

type Props = { page: Page<NormalizedPost> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout
    title="Blog"
    description="Writing on software, engineering, and things worth thinking about."
    showHeader={false}
>
    <h1 class="mb-12 text-2xl font-semibold sm:mb-16 sm:text-4xl">Blog</h1>
    {blog.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" />)}
    <Pagination page={page} class="my-16 sm:my-24" />
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>
